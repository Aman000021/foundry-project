# This is a sample on how to deploy both infrastructure as well as code.  This workflow calls a separate workflow from a different repository
# To make sure you deploy the correct environments change the default environments to your personal environments
# For example if you have environments (dv, np, pr) change the environment: 'ts' to 'np' as well as 'pp' to 'pr'
name: Build Hosted Agent Image

on: 
    workflow_dispatch:
      inputs:
        appName:
          description: Name of usecase
          type: string
          required: true
        agentName:
          description: Name of Agent
          type: string
          required: true
        hostedAgentDir:
          description: Path of hosted agent code
          type: string
          required: true
        deployAgentDir:
          description: Path of deployment code
          type: string
          required: true
        agentSize:
          description: 'Resource size of Agent'
          required: false
          type: choice
          default: 'small'
          options:
              - small
              - medium
              - large
        environment:
          description: 'Environments'
          required: false
          type: choice
          default: 'dv'
          options:
              - dv
              - pp
              - pr

permissions:
    id-token: write
    contents: read
    issues: write

concurrency:
  group: terraform-${{ github.ref }}
  cancel-in-progress: false

jobs:
     Agent-Deploy:
        uses: nestle-it/foundry-code-patterns/.github/workflows/hosted-agent-deploy.yml@main
        with: 
          environment: 'dv'
          appName: {% raw %}${{ inputs.appName }}{% endraw %}
          agentSize: {% raw %}${{ inputs.agentSize }}{% endraw %}
          agentName: {% raw %}${{ inputs.agentName }}{% endraw %}
          runner_type: ${{ values.runner | dump }}
          hostedAgentDir: {% raw %}${{ inputs.hostedAgentDir }}{% endraw %}
          deployAgentDir: {% raw %}${{ inputs.deployAgentDir }}{% endraw %}
        secrets: inherit
