---
# Client secret of the Entra app Prometheus signs in with for Azure Monitor remote write.
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: monitoringstack-oauth
  namespace: ${{ values.secretSourceNamespace }}
spec:
  data:
    - remoteRef:
        conversionStrategy: Default
        decodingStrategy: None
        key: ${{ values.prometheusRemoteWriteSecret }}
        metadataPolicy: None
      secretKey: secret
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: azkeyvault-secret-store
  target:
    creationPolicy: Owner
    name: monitoringstack-oauth
