---
apiVersion: loki.grafana.com/v1
kind: LokiStack
metadata:
  name: logging-loki
  namespace: openshift-logging
spec:
  managementState: Managed
  size: 1x.extra-small
  replicationFactor: 1
  storageClassName: managed-csi
  storage:
    schemas:
      - version: v13
        effectiveDate: '2024-01-01'
    secret:
      name: loki-azure-storage
      type: azure
  limits:
    global:
      ingestion:
        ingestionBurstSize: 16
        ingestionRate: 1000
      retention:
        days: 7
    tenants:
      application:
        ingestion:
          ingestionBurstSize: 100
          ingestionRate: 10000
        otlp:
          streamLabels:
            resourceAttributes:
              - name: tenant
              - name: cluster.name
              - name: environment
              - name: k8s.namespace.name
              - name: k8s.pod.name
              - name: k8s.container.name
              - name: service.name
  template:
    ingester:
      replicas: 2
  tenants:
    mode: openshift-logging
    openshift:
      otlp:
        enableConsoleLabels: true
