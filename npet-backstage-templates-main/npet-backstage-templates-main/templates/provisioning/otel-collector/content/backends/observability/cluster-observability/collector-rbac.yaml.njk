---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: nestle-otel-collector
  namespace: openshift-monitoring

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: nestle-otel-collector
rules:
  # k8sattributes processor
  - apiGroups: ['']
    resources: [pods, namespaces]
    verbs: [get, list, watch]
  - apiGroups: [apps]
    resources: [replicasets]
    verbs: [get, list, watch]
  # Write to every Tempo tenant, including the generated per-application ones.
  - apiGroups: [tempo.grafana.com]
    resources: ['*']
    resourceNames: [traces]
    verbs: [create]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: nestle-otel-collector
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: nestle-otel-collector
subjects:
  - kind: ServiceAccount
    name: nestle-otel-collector
    namespace: openshift-monitoring

---
# Write to the Loki application tenant, using the role the logging operator provides.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: nestle-otel-collector-write-application-logs
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-logging-write-application-logs
subjects:
  - kind: ServiceAccount
    name: nestle-otel-collector
    namespace: openshift-monitoring
