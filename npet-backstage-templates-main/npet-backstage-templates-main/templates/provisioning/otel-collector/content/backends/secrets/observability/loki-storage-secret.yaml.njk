---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: loki-azure-storage
  namespace: ${{ values.secretSourceNamespace }}
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: azkeyvault-secret-store
  target:
    name: loki-azure-storage
    creationPolicy: Owner
    template:
      data:
        environment: AzureGlobal
        container: ${{ values.clusterName }}-loki
        account_name: ${{ values.storageAccount }}
        account_key: '{{ .account_key }}'
  data:
    - secretKey: account_key
      remoteRef:
        key: ${{ values.storageSecretPrefix }}-key
