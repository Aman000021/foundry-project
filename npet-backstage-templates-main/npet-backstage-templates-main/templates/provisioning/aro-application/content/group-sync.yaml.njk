---
apiVersion: redhatcop.redhat.io/v1alpha1
kind: GroupSync
metadata:
  name: ${{ values.name | lower }}
  namespace: group-sync-operator
  annotations:
    argocd.argoproj.io/sync-options: SkipDryRunOnMissingResource=true
    argocd.argoproj.io/sync-wave: "3"
spec:
  providers:
  - name: azure
    azure:
      authorityHost: "https://login.microsoftonline.com/12a3af23-a769-4654-847f-958f3d479f4a"
      credentialsSecret:
        name: azure-group-sync
        namespace: group-sync-operator
      groups:
      {% for group in values.namespaceOwnerGroups -%}
      - "${{ group }}"  
      {% endfor %}
      prune: false
  schedule: "*/30 * * * *"
