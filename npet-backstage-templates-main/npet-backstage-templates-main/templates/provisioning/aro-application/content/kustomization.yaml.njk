---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - resource/group-sync.yaml
  - resource/app-project.yaml
  - resource/repository.yaml
  {%- for a in values.environments %}
  - resource/${{ a }}/application.yaml
  - resource/${{ a }}/namespace.yaml
  - resource/${{ a }}/image-pull-secret.yaml
  {%- endfor %}
