---
apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: ${{ values.name | dump }}
  {%- if values.namespace %}
  namespace: ${{ values.namespace | dump }}
  {%- endif %}
  {%- if values.description %}
  description: ${{ values.description | dump }}
  {%- endif %}
  annotations:
    nestle.com/entity-visibility: ${{ values.visibility }}
    nestle.com/domain: ${{ values.domain }}
    github.com/project-slug: ${{ values.repourl.allowedOwners }}/${{ values.repourl.allowedRepos }}
  {%- for a in values.annotations %}
    ${{ a.key }}: ${{ a.value }}
  {%- endfor %}
  {%- if values.tags | length %}
  tags:
  {%- for a in values.tags %}
    - ${{ a | lower }}
  {%- endfor %}
  {%- endif %}
spec:
  type: ${{ values.type | dump }}
  lifecycle: ${{ values.lifecycle | dump }}
  owner: ${{ values.owner | dump }}
  {%- if values.system %}
  system: ${{ values.system | dump }}
  {%- endif %}
  {%- if values.subcomponentOf %}
  subcomponentOf: ${{ values.subcomponentOf | dump }}
  {%- endif %}
  {%- if values.providesApis | length %}
  providesApis:
  {%- for api in values.providesApis %}
    - ${{ api }}
  {%- endfor %}
  {%- endif %}
  {%- if values.consumesApis | length %}
  consumesApis:
  {%- for api in values.consumesApis %}
    - ${{ api }}
  {%- endfor %}
  {%- endif %}
  {%- if values.dependsOn | length %}
  dependsOn:
  {%- for d in values.dependsOn %}
    - ${{ d }}
  {%- endfor %}
  {%- endif %}
  {%- if values.dependencyOf | length %}
  dependencyOf:
  {%- for d in values.dependencyOf %}
    - ${{ d }}
  {%- endfor %}
  {%- endif %}
