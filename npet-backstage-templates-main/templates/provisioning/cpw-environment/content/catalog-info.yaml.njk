apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: ${{ values.name | dump }}
  annotations:
  {%- for a in values.annotations %}
    ${{ a.key }}: ${{ a.value }}
  {%- endfor %}
  links:
    - url: ${{ values.github.url }}
      title: GitHub Repository
      icon: github
spec:
  type: service
  owner: ${{ values.owner }}
  lifecycle: experimental
  system: ${{ values.system | dump }}
  {%- if values.dependencyOf | length %}
  dependencyOf:
  {%- for d in values.dependencyOf %}
    - ${{ d }}
  {%- endfor %}
  {%- endif %}
