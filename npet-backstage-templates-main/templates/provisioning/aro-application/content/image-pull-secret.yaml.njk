---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: ${{ values.name | lower }}-pullsecret
  namespace: ${{ values.namespace }}
spec:
  data:
    - remoteRef:
        conversionStrategy: Default
        key: ${{ values.keyVaultSecretName }}
        metadataPolicy: None
      secretKey: imagepull
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: azkeyvault-secret-store
  target:
    name: ${{ values.name | lower }}-pullsecret
    creationPolicy: Owner
    deletionPolicy: Merge
    template:
      type: kubernetes.io/dockerconfigjson
      data:
        # use a "raw" template to ensure the manifest generated by ACM still has the correct curly braces
        # the template should be filled by external-secrets-operator, not ACM
        .dockerconfigjson: '{{`{{ .imagepull }}`}}'