---
apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: ${{ values.name | dump }}
  description: OpenShift namespace for the ${{ values.environment | upper }} environment. Includes container registry, ArgoCD application, and deployment configuration.
  annotations:
    nestle.com/entity-visibility: internal
    nestle.com/environment: ${{ values.environment | dump }}
    nestle.com/namespace-owner-group: ${{ values.namespaceOwnerGroup | dump }}
    quay.io/repository-slug: ${{ values.quayRepositorySlug | dump }}
    aro.openshift.com/cluster: ${{ values.aroCluster | dump }}
    aro.openshift.com/namespace: ${{ values.name | dump }}
    argocd.argoproj.io/application: ${{ values.name | dump }}
  links:
    - url: ${{ values.quayRepositoryUrl }}
      title: Quay Repository
      icon: publish
    - url: https://argo.apps.dximllac.eastus.aroapp.io/applications/openshift-gitops/${{ values.name | lower }}
      title: ArgoCD Application
      icon: dashboard
    - url: https://console-openshift-console.apps.dximllac.eastus.aroapp.io/k8s/cluster/projects/${{ values.name | lower }}
      title: OpenShift Console
      icon: catalog
    - url: https://${{ values.name | lower }}.apps.dximllac.eastus.aroapp.io/
      title: Application Route
      icon: web
spec:
  type: service
  owner: ${{ values.owner | dump }}
  system: ${{ values.system | dump }}
  lifecycle: production
  dependsOn:
    - component:default/${{ values.componentName }}
