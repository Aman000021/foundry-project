apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: ${{ values.argoRepoName | dump }}
  description: Application source code repository for ${{ values.applicationName | dump }}. Contains Helm charts and CI/CD workflows for deployment to ARO environments.
  annotations:
    nestle.com/entity-visibility: internal
    nestle.com/parent-process: aro
    nestle.com/application-name: ${{ values.applicationName | dump }}
    nestle.com/environments: '${{ values.environments }}'
    nestle.com/argo-repo-owner: ${{ values.argoRepoOwner | dump }}
    nestle.com/argo-repo-name: ${{ values.argoRepoName | dump }}
    nestle.com/argo-repo-url: ${{ values.argoRepoUrl | dump }}
    nestle.com/quay-robot-name: ${{ values.quayRobotName | dump }}
    github.com/project-slug: ${{ values.projectSlug | dump }}
    backstage.io/techdocs-ref: dir:.
  links:
    - url: ${{ values.githubUrl }}
      title: GitHub Repository
      icon: github
    {%- for env in values.environments %}
    - url: https://${{ values.argoRepoName }}-${{ env }}.apps.dximllac.eastus.aroapp.io/
      title: ${{ env | upper }} Environment
      icon: dashboard
    {%- endfor %}
spec:
  type: service
  owner: ${{ values.owner }}
  lifecycle: experimental
  system: ${{ values.system | dump }}
