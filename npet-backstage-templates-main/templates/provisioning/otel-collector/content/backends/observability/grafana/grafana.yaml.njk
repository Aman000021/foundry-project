---
apiVersion: v1
kind: Namespace
metadata:
  name: grafana

---
# Admin credentials are generated by the operator into grafana-admin-credentials.
apiVersion: grafana.integreatly.org/v1beta1
kind: Grafana
metadata:
  name: grafana
  namespace: grafana
  labels:
    dashboards: grafana
spec:
  config:
    log:
      mode: console
    auth:
      disable_login_form: 'false'
  persistentVolumeClaim:
    spec:
      accessModes:
        - ReadWriteOnce
      storageClassName: managed-csi
      resources:
        requests:
          storage: 20Gi
  deployment:
    spec:
      # ReadWriteOnce volume: the old pod must release it before the new one starts.
      strategy:
        type: Recreate
      template:
        spec:
          volumes:
            - name: grafana-data
              persistentVolumeClaim:
                claimName: grafana-pvc
  route:
    spec: {}
