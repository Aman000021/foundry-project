---
apiVersion: tempo.grafana.com/v1alpha1
kind: TempoStack
metadata:
  name: simplest
  namespace: openshift-tempo-operator
spec:
  managementState: Managed
  replicationFactor: 2
  storageClassName: managed-csi
  storageSize: 10Gi
  storage:
    secret:
      name: tempo-azure-storage
      type: azure
  retention:
    global:
      traces: 48h0m0s
  resources:
    total:
      limits:
        cpu: '4'
        memory: 8Gi
  search:
    defaultResultLimit: 20
  timeout: 30s
  networkPolicy:
    enabled: true
  tenants:
    mode: openshift
    # Fallback tenant. The tenants/ component the observability-update workflow
    # generates replaces this list with it plus one tenant per application.
    authentication:
      - tenantName: platform
        tenantId: platform
  template:
    gateway:
      enabled: true
      ingress:
        type: route
        route:
          termination: reencrypt
    ingester:
      replicas: 2
    queryFrontend:
      jaegerQuery:
        enabled: true
        servicesQueryDuration: 72h0m0s
