---
apiVersion: policy.open-cluster-management.io/v1
kind: ConfigurationPolicy
metadata:
  name: ${{ values.azureMonitorSecretName }}
  namespace: ${{ values.clusterPoliciesNamespace }}
  annotations:
    argocd.argoproj.io/sync-options: SkipDryRunOnMissingResource=true
spec:
  object-templates:
    - complianceType: musthave
      objectDefinition:
        apiVersion: v1
        kind: Secret
        metadata:
          name: ${{ values.azureMonitorSecretName }}
          namespace: openshift-monitoring
        data: '{{hub copySecretData "${{ values.secretSourceNamespace }}" "${{ values.azureMonitorSecretName }}" hub}}'
  pruneObjectBehavior: None
  remediationAction: enforce
  severity: low
