---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: ${{ values.azureMonitorSecretName }}
  namespace: ${{ values.secretSourceNamespace }}
spec:
  data:
    - remoteRef:
        conversionStrategy: Default
        decodingStrategy: None
        key: ${{ values.azureMonitorSecretName }}
        metadataPolicy: None
      secretKey: connection_string
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: azkeyvault-secret-store
  target:
    creationPolicy: Owner
    name: ${{ values.azureMonitorSecretName }}
