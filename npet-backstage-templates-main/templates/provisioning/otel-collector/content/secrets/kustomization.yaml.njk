---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
metadata:
  name: observability-secrets
  annotations:
    # The observability-update workflow in this repo adds this folder to the
    # cluster's secrets/kustomization.yaml only when this annotation is present.
    nestle.com/managed-by: backstage-otel-collector

resources:
  - monitoringstack-secret.yaml
  - opentelemetrycollector-secret.yaml
  - azure-logs-ingestion-secret.yaml
  - loki-storage-secret.yaml
  - tempo-storage-secret.yaml
