---
# Client secret of the Entra app the log forwarder signs in with to the
# Azure Monitor Logs Ingestion API.
{%- if not values.logsIngestionConfigured %}
# PLACEHOLDER: the Key Vault secret name below is not set yet (see the PR description).
{%- endif %}
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: azure-logs-ingestion
  namespace: ${{ values.secretSourceNamespace }}
spec:
  data:
    - remoteRef:
        conversionStrategy: Default
        decodingStrategy: None
        key: ${{ values.logsIngestionSecret }}
        metadataPolicy: None
      secretKey: client-secret
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: azkeyvault-secret-store
  target:
    creationPolicy: Owner
    name: azure-logs-ingestion
