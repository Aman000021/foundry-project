---
apiVersion: backstage.io/v1alpha1
kind: System
metadata:
  name: ${{ values.name | dump }}
  {%- if values.namespace %}
  namespace: ${{ values.namespace | dump }}
  {%- endif %}
  {%- if values.description %}
  description: ${{ values.description | dump }}
  {%- endif %}
  annotations:
    nestle.com/entity-visibility: '${{ values.visibility }}'
    nestle.com/system-ownership: '${{ values.ownership }}'
  {%- for a in values.annotations %}
    ${{ a.key }}: '${{ a.value }}'
  {%- endfor %}
  {%- if values.tags | length %}
  tags:
  {%- for a in values.tags %}
    - ${{ a }}
  {%- endfor %}
  {%- endif %}
spec:
  owner: ${{ values.owner | dump }}
  domain: ${{ values.domain.name | dump }}
  lifecycle: experimental
