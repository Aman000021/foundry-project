---
apiVersion: "backstage.io/v1alpha1"
kind: "Resource"
metadata:
  name: ${{ values.name | dump }}
  {%- if values.namespace %}
  namespace: ${{ values.namespace | dump }}
  {%- endif %}
  {%- if values.description %}
  description: ${{ values.description | dump }}
  {%- endif %}
  {%- if values.clusterType %}
  labels:
    cluster-type: ${{ values.clusterType | dump }}
  {%- endif %}
  annotations:
  {%- if values.visibility %}
    nestle.com/entity-visibility: ${{ values.visibility | dump }}
  {%- endif %}
    nestle.com/domain: ${{ values.domain | dump }}
  {%- for key, value in values.resourceProperties %}
  {%- if key in ["queues", "shares", "containers", "managementPolicies", "specificIpRanges", "specificSubnets", "eventhubs"] %}
    nestle.com/${{ key.replace(' ','-') }}: ${{ value | sanitize }}
  {%- else %}
    nestle.com/${{ key.replace(' ','-') }}: ${{ value | sanitize | dump }}
  {%- endif %}
  {%- endfor %}
  {%- for key, value in values.resourceTags %}
    nestle.com/${{ key.replace(' ','-') }}: ${{ value | dump }}
  {%- endfor %}
  {%- for a in values.annotations %}
  {%- if a.value %}
    ${{ a.key }}: ${{ a.value | dump }}
  {%- endif %}
  {%- endfor %}
  {%- if values.links | length %}
  links:
  {%- for l in values.links %}
    - url: ${{ l.url | dump }}
      title: ${{ l.title | dump }}
      {%- if l.icon %}
      icon: ${{ l.icon | dump }}
      {%- endif %}
  {%- endfor %}
  {%- endif %}
  {%- if values.tags | length %}
  tags:
  {%- for a in values.tags %}
    - ${{ a | lower | dump }}
  {%- endfor %}
  {%- endif %}
spec:
  type: ${{ values.type | dump }}
  owner: ${{ values.owner | dump }}
  {%- if values.system %}
  system: ${{ values.system | dump }}
  {%- endif %}
  {%- if values.dependsOn | length %}
  dependsOn:
  {%- for d in values.dependsOn %}
    - ${{ d }}
  {%- endfor %}
  {%- endif %}
  {%- if values.dependencyOf | length %}
  dependencyOf:
  {%- for d in values.dependencyOf %}
    - ${{ d }}
  {%- endfor %}
  {%- endif %}
